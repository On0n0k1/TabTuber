# Local working documents (intentionally untracked)
CLAUDE.md
SPEC.md
DOCS.md

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Rust / WASM (when introduced)
target/
pkg/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store

# Logs
*.log
npm-debug.log*

# Documentation pages, rendered from docs/ by scripts/build-docs.mjs. The
# markdown in docs/ is the source; this is the generated HTML.
public/docs/

# MediaPipe runtime assets, staged by scripts/fetch-assets.mjs
public/mediapipe/
# Staged at build time by scripts/fetch-assets.mjs, except the two avatars
# below, which are committed because they are what the model picker offers.
public/models/*
!public/models/AvatarSample_B.vrm
!public/models/AvatarSample_X.vrm
