{
  "name": "virtual-avatar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Webcam-driven stylized 3D avatar for VTubing",
  "scripts": {
    "predev": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "check:math": "node --experimental-strip-types src/solver/math.check.ts",
    "check:solver": "node --experimental-strip-types src/solver/poseSolver.check.ts",
    "check": "npm run check:math && npm run check:solver && npm run check:filter",
    "check:filter": "node --experimental-strip-types src/filter/oneEuro.check.ts"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  }
}
