{
  "name": "tabtuber",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "description": "Webcam-driven stylized 3D avatar for VTubing",
  "scripts": {
    "predev": "node scripts/fetch-assets.mjs && node scripts/build-docs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-assets.mjs && node scripts/build-docs.mjs",
    "build": "tsc --noEmit && vite build",
    "build:docs": "node scripts/build-docs.mjs",
    "preview": "vite preview",
    "release": "semantic-release",
    "typecheck": "tsc --noEmit",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "check:math": "node --experimental-strip-types src/solver/math.check.ts",
    "check:solver": "node --experimental-strip-types src/solver/poseSolver.check.ts",
    "check": "npm run check:math && npm run check:solver && npm run check:filter && npm run check:buffer && npm run check:mouth && npm run check:gate && npm run check:vowel && npm run check:face && npm run check:expression && npm run check:toolbar && npm run check:interp && npm run check:banner && npm run check:style",
    "check:filter": "node --experimental-strip-types src/filter/oneEuro.check.ts",
    "inspect-vrm": "node scripts/inspect-vrm.mjs",
    "shrink-vrm": "node scripts/shrink-vrm.mjs",
    "check:buffer": "node --experimental-strip-types src/render/poseBuffer.check.ts",
    "check:mouth": "node --experimental-strip-types src/audio/mouth.check.ts",
    "check:gate": "node --experimental-strip-types src/audio/speechGate.check.ts",
    "check:vowel": "node --experimental-strip-types src/audio/vowelSpace.check.ts",
    "check:face": "node --experimental-strip-types src/solver/faceSolver.check.ts",
    "check:expression": "node --experimental-strip-types src/render/expressionControl.check.ts",
    "check:toolbar": "node --experimental-strip-types src/ui/toolbar.check.ts",
    "check:interp": "node --experimental-strip-types src/render/poseInterpolator.check.ts",
    "check:banner": "node --experimental-strip-types src/ui/statusBanner.check.ts",
    "check:style": "node --experimental-strip-types src/ui/style.check.ts"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/three": "^0.186.0",
    "marked": "^15.0.12",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@pixiv/three-vrm": "^3.5.5",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  }
}
